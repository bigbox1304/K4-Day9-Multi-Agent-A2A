# OpenAI-compatible endpoint for a local/sub-10B model.
# Examples: LM Studio, vLLM, Ollama OpenAI compatibility.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Number of cases processed concurrently. Increase carefully in hybrid/full mode.
CASE_CONCURRENCY=2
SPECIALIST_CONCURRENCY=2
LLM_MAX_TOKENS=512
LLM_ORCHESTRATION_MODE=hybrid
