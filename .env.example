# OpenAI-compatible endpoint for a local/sub-10B model.
# Examples: LM Studio, vLLM, Ollama OpenAI compatibility.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=put_your_openrouter_key_here
LLM_MODEL=qwen/qwen3-8b
# Number of cases processed concurrently. Increase carefully because each case
# also fans out to four specialist LLM calls.
CASE_CONCURRENCY=2
